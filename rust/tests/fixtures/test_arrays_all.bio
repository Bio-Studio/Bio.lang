program main;

Main {
    void exec() {
        ALL a = new Array(2);
        a::set(0, 10); a::set(1, 20);
        ALL v = Arrays::vector();
        v::push(5);
        CIO::println("count:", get Arrays::count());
        ALL all_arr = get Arrays::all();
        CIO::println("all:", all_arr);
        CIO::println("all len:", get all_arr::len());
        CIO::println("all[0]:", all_arr[0]);
    }
}
