program main;

Class Box {
    void __init__(v int) { this::val = v; }
    int val;
}

Main {
    void exec() {
        Box b = new Box(99);
        CIO::println("b.val =", get b::val);
        Array a = new Array(3);
        a::set(0, 7);
        CIO::println("a[0] =", a[0], "len:", get a::len());
    }
}
