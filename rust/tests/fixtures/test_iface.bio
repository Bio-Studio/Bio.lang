program main;

Interface Shape {
    double area();
    void draw();
}

Class Circle implements Shape {
    double area() { res 3.14 * this::r * this::r; }
    void draw() { CIO::println("drawing circle"); }
    double r;
}

Main {
    void exec() {
        Circle c = new Circle();
        c::r = 2.0;
        CIO::println("area:", get c::area());
        c::draw();
    }
}
