// project/utils/greeter.bio — provides the method greet().
//
// Any method named `greet` satisfies the `need function greet;` in main.bio.
// It can then be called as a bare call.

Stream Greeter {
    void greet(name string);
}
Greeter G {
    void greet(name string) {
        IO::println("hello,", name);
    }
}
