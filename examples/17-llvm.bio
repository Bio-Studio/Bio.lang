// 17-llvm.bio
// Stage-1 LLVM backend example: loops, a user method, recursion-free calls,
// int locals, and CIO output all compile to native code with `bio llvm`.

program main;

Main {
    int square(x int) {
        res x * x;
    }

    void exec() {
        int sum = 0;
        for (int i = 1; i <= 10; i = i + 1;) {
            sum = sum + square(i);
        }
        CIO::println("sum of squares 1..10 =", sum);
    }
}

// Expected output:
//   sum of squares 1..10 = 385
