// 01-hello.bio
// Teaches: the basic skeleton of every BioLang program.
//
// A program starts with `program main;` and defines the main program stream
// `Main`. Its `exec()` method is the entry point that runs when you execute
// the file.
//
// `IO` is the universal IO stream (always present). `IO::println(...)` writes
// its arguments (space-separated) followed by a newline.

program main;

Main {
    void exec() {
        IO::println("Hello, BioLang!");
        IO::println("Every call in BioLang is a request.");
        IO::println("This one was just a request to print a line.");
    }
}

// Expected output:
//   Hello, BioLang!
//   Every call in BioLang is a request.
//   This one was just a request to print a line.
