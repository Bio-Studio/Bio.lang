// 12-computation.bio
// Teaches: the Com computation stream and Time timers.
//
// Com handles instant math: abs/min/max/pow/sqrt/floor/ceil/round/sign/
// sin/cos/tan/log/exp. Time owns several timers per thread: the first timer
// belongs to the thread and cannot be reset; timers from Time::fork may be
// reset.

program main;

Main {
    void exec() {
        // Com computation stream.
        IO::println("Com::abs(0-5) =", Com::abs(0 - 5).res,
                     "  Com::sqrt(9) =", Com::sqrt(9).res);
        IO::println("Com::pow(2,10) =", Com::pow(2, 10).res);
        IO::println("Com::min(3,5) =", Com::min(3, 5).res,
                     "  Com::max(3,5) =", Com::max(3, 5).res);
        IO::println("Com::sign(0-3) =", Com::sign(0 - 3).res);
        IO::println("Com::floor(2.7) =", Com::floor(2.7).res,
                     "  Com::ceil(2.7) =", Com::ceil(2.7).res,
                     "  Com::round(2.5) =", Com::round(2.5).res);
        IO::println("Com::log(1) =", Com::log(1).res);

        // Time::start starts the thread's first timer.
        Time::start();
        Time::sleep(50);                        // sleep 50 ms
        IO::println("elapsed after ~50ms =", Time::elapsed().res);

        // Time::fork creates a resettable timer; the first timer refuses reset.
        ALL t2 = Time::fork();
        IO::println("reset first timer →", Time::reset().cause);
        Time::reset(t2.res);                    // forked timer resets fine
        IO::println("Time::reset(forked) ok");
    }
}

// Expected output (elapsed value varies slightly):
//   Com::abs(0-5) = 5   Com::sqrt(9) = 3
//   Com::pow(2,10) = 1024
//   Com::min(3,5) = 3   Com::max(3,5) = 5
//   Com::sign(0-3) = -1
//   Com::floor(2.7) = 2   Com::ceil(2.7) = 3   Com::round(2.5) = 3
//   Com::log(1) = 0
//   elapsed after ~50ms = 0.050...
//   reset first timer → Time refused: first timer (thread default) cannot be reset; use Time::fork()
//   Time::reset(forked) ok
